# Placeholders only. Copy to .env locally. Never commit .env.
# In staging/production, use a secrets manager instead of a file.

NODE_ENV=development
# Deployment: development | test | staging | production
APP_ENV=development

# Database (use a private network address in production)
# App login: member of app_public, app_company, app_admin only (see docs/database.md)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Schema owner, used only by migrations and the sample seed. Never by the running app.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Redis (rate limiting, sessions)
REDIS_URL=redis://HOST:6379

# Session and auth
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
AUTH_URL=http://localhost:3000

# Field-level encryption key for contact details (32 random bytes, base64)
FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_KEY

# Bot protection (public quote form)
BOT_PROTECTION_SITE_KEY=REPLACE
BOT_PROTECTION_SECRET_KEY=REPLACE

# Email provider (transactional)
EMAIL_API_KEY=REPLACE
EMAIL_FROM=no-reply@example.com
